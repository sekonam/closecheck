# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Runtime app connection — the least-privilege role created by
# prisma/migrations/20260911160500_least_privilege_app_role. MUST NOT be a superuser/BYPASSRLS role:
# Postgres exempts both from row-level security entirely, which would make prisma/migrations/*_row_
# level_security silently no-op (confirmed locally with scripts/verify-rls.ts — this was a real bug).
DATABASE_URL="postgresql://closecheck_app:CHANGE_ME@localhost:55432/closecheck?schema=public"

# Superuser/owner connection used ONLY by the Prisma CLI (migrate, db push, studio) — schema changes,
# and creating/granting the app role above, need privileges the app role deliberately lacks. Never
# point the running application at this URL.
DIRECT_DATABASE_URL="postgresql://closecheck:CHANGE_ME@localhost:55432/closecheck?schema=public"

# Used ONLY by src/lib/auth/db.ts, for the one legitimate cross-tenant lookup in the app: finding a
# user by email during sign-in, before an org is known. Grants: SELECT on `users` only — nothing
# else. See prisma/migrations/20260911161500_auth_lookup_role.
AUTH_DATABASE_URL="postgresql://closecheck_auth:CHANGE_ME@localhost:55432/closecheck?schema=public"

# Used ONLY by src/lib/auth/signupDb.ts, for self-serve signup's bootstrap insert (creating the first
# ConsultantOrg + owner User with no org session yet to scope by). Grants: INSERT on
# `consultant_orgs`/`users` only. See prisma/migrations/20260918100000_signup_role.
SIGNUP_DATABASE_URL="postgresql://closecheck_signup:CHANGE_ME@localhost:55432/closecheck?schema=public"

# Used ONLY by src/lib/portal/db.ts, for the public Client Portal Link view (spec.md §7) — a buyer
# with no CloseCheck account or org session, authorized by the link token alone. Grants: SELECT on
# `client_portal_links`/`reports` and INSERT on `portal_access_log`, all scoped per-request to the one
# presented token via RLS (not org). See prisma/migrations/20260918100100_portal_role.
PORTAL_DATABASE_URL="postgresql://closecheck_portal:CHANGE_ME@localhost:55432/closecheck?schema=public"

# Used ONLY by src/lib/api/db.ts, for the read-only API's bearer-token lookup (docs/spec.md §13.2) —
# finding an api_keys row by token hash before any org is known, the same shape as sign-in's email
# lookup. Grants: SELECT on `api_keys` plus UPDATE on its "lastUsedAt" column only. See
# prisma/migrations/20260921120000_api_keys_and_webhooks.
API_DATABASE_URL="postgresql://closecheck_api:CHANGE_ME@localhost:55432/closecheck?schema=public"

# --- Phase 2.5 revenue readiness (docs/roadmap.md Phase 2.5) ---

# Transactional email (src/lib/email/) — Resend. Unset = dev fallback: emails are recorded in the
# email_messages table with status LOGGED (and echoed to the server console) instead of delivered.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="CloseCheck <notifications@yourdomain.com>"

# Billing (src/lib/billing/) — Stripe. All unset = billing not configured: the app runs in grace
# mode (no checkout surface, no audit-credit enforcement). Price IDs come from the Stripe dashboard
# after creating the four recurring prices + one one-off overage price.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."           # from the dashboard's webhook endpoint for /api/stripe/webhook
# STRIPE_PRICE_SOLO_MONTHLY="price_..."
# STRIPE_PRICE_SOLO_ANNUAL="price_..."
# The TEAM prices are the cost of ONE ADDITIONAL SEAT, not the cost of a Team plan: spec.md §9
# defines Team as "additional seats ... on top of the base", so a Team subscription is the SOLO
# price plus one per-seat line for every seat past the first. Setting these to a whole-plan amount
# makes Team cheaper than Solo. See src/lib/billing/config.ts.
# STRIPE_PRICE_TEAM_MONTHLY="price_..."       # per additional seat, monthly
# STRIPE_PRICE_TEAM_ANNUAL="price_..."        # per additional seat, annual
# STRIPE_PRICE_AUDIT_OVERAGE="price_..."      # one-off price used for batched overage invoice items
# Included full-audit credits granted per billing year (spec.md §9 — config-changeable, every number
# is still awaiting the Phase 0 head-to-head test). Defaults live in src/lib/billing/config.ts.
# BILLING_INCLUDED_AUDITS_MONTHLY="3"
# BILLING_INCLUDED_AUDITS_ANNUAL="6"
# Enforcement stays OFF until the docs/releases.md §5 Phase 2.5/4 gates are met — with it off,
# audits are created freely and consumption is only recorded; with it on, an org with no active
# subscription and no credit balance is blocked from creating a full audit.
# BILLING_ENFORCEMENT="false"
# Seats included in a Team plan (spec.md §9's "up to ~5"). Only enforced when BILLING_ENFORCEMENT
# is on; Solo is always a single seat.
# BILLING_TEAM_MAX_SEATS="5"

# Read-only API (src/lib/api/) — requests per minute, per API key for authenticated callers and per
# client address for failed ones. In-process and therefore PER INSTANCE: with more than one
# instance the effective limit is this value times the instance count, so replace the limiter with a
# shared store before scaling horizontally, not after. See src/lib/api/rateLimit.ts.
# API_RATE_LIMIT_PER_MINUTE="120"

# Sign-in attempt budgets (src/lib/auth/rateLimit.ts). Two budgets keyed differently on purpose:
# per client address counts every attempt and refuses before any password work (catches spraying);
# per email+address counts only FAILED attempts over a 15-minute window and is cleared on a
# successful sign-in. The address is part of the second key so an attacker's wrong guesses cannot
# lock a victim out of their own account from somewhere else.
# AUTH_RATE_LIMIT_PER_MINUTE_ADDRESS="30"
# AUTH_MAX_FAILED_SIGNINS="10"

# NextAuth
AUTH_SECRET="CHANGE_ME"
NEXTAUTH_URL="http://localhost:3000"

# Optional: override the Chromium binary used for PDF report rendering (see src/lib/reports/pdf.ts).
# Needed in sandboxed/local environments where `playwright install chromium` cannot fetch a browser.
# PLAYWRIGHT_CHROMIUM_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
