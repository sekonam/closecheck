{
  "name": "closecheck",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx -r dotenv/config prisma/seed.ts",
    "db:verify-rls": "tsx -r dotenv/config scripts/verify-rls.ts",
    "db:verify-signup-portal-roles": "tsx -r dotenv/config scripts/verify-signup-portal-roles.ts",
    "db:verify-template-versioning": "tsx -r dotenv/config scripts/verify-template-versioning.ts",
    "db:publish-tiera-expansion": "tsx -r dotenv/config scripts/publish-tierA-expansion.ts",
    "db:verify-api-role": "tsx -r dotenv/config scripts/verify-api-role.ts",
    "db:verify-billing-credits": "tsx -r dotenv/config scripts/verify-billing-credits.ts",
    "db:purge-expired-documents": "tsx -r dotenv/config scripts/purge-expired-documents.ts",
    "metrics:report": "tsx -r dotenv/config scripts/metrics-report.ts",
    "db:rotate-production-role-passwords": "tsx -r dotenv/config scripts/rotate-production-role-passwords.ts",
    "ops:dashboard": "tsx -r dotenv/config scripts/ops-dashboard.ts",
    "ops:errors": "tsx -r dotenv/config scripts/ops-error-triage.ts",
    "ops:backup-drill": "tsx -r dotenv/config scripts/ops-backup-drill.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "playwright": "^1.63.0",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^22.6.2",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
