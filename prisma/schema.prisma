// CloseCheck domain model — see docs/spec.md §3 for the definitions this mirrors.
//
// Tenant isolation (docs/spec.md §8, the load-bearing non-functional requirement) is enforced at
// TWO layers, deliberately redundant:
//   1. Every tenant-owned table carries `orgId` and the application layer (src/lib/db/scoped.ts)
//      never issues a query without it.
//   2. Postgres row-level security policies (prisma/migrations/*_rls/migration.sql) enforce the same
//      boundary at the database layer, so a bug in (1) cannot leak across tenants on its own.
// Do not add a tenant-owned table without both.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime app connection — MUST be a least-privilege role (closecheck_app), never the migration
  // superuser. See prisma/migrations/*_least_privilege_app_role and scripts/verify-rls.ts: RLS is
  // silently bypassed for any superuser/BYPASSRLS role, which is exactly what the Docker Postgres
  // bootstrap role is.
  url       = env("DATABASE_URL")
  // Schema migrations run against this instead — needs elevated privileges (CREATE TABLE, ALTER,
  // CREATE ROLE, GRANT) that the app role deliberately does not have.
  directUrl = env("DIRECT_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & auth
// ---------------------------------------------------------------------------

model ConsultantOrg {
  id            String   @id @default(cuid())
  name          String
  // Whitelabel brand kit — spec.md §6. Logo is a URL into object storage, not inline bytes.
  brandLogoUrl  String?
  brandColorHex String?
  // Required-review gate on the standard report disclaimer language (spec.md §6: "required review by
  // the consultant, not optional boilerplate the product silently inserts without them seeing it").
  // Null = not yet reviewed; generateReport (src/lib/actions/reports.ts) refuses to run until this is
  // set. Src/lib/reports/disclaimer.ts is the single source of truth for the text being acknowledged
  // — a future wording change should null this out again via migration, not leave stale consent
  // standing for language nobody actually reviewed.
  disclaimerAcknowledgedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users             User[]
  engagements       Engagement[]
  audits            Audit[]
  findings          Finding[]
  evidence          Evidence[]
  reports           Report[]
  clientPortalLinks ClientPortalLink[]
  vendorTermProfiles VendorTermProfile[]
  apiKeys           ApiKey[]
  webhookEndpoints  WebhookEndpoint[]
  emailMessages     EmailMessage[]
  billingAccount    BillingAccount?
  creditLedger      AuditCreditEntry[]

  @@map("consultant_orgs")
}

enum UserRole {
  OWNER
  MEMBER
}

model User {
  id           String        @id @default(cuid())
  orgId        String
  org          ConsultantOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email        String        @unique
  passwordHash String
  name         String?
  role         UserRole      @default(OWNER)
  createdAt    DateTime      @default(now())

  uploadedEvidence   Evidence[]
  createdPortalLinks ClientPortalLink[]

  @@index([orgId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Engagement & Audit — spec.md §3
// ---------------------------------------------------------------------------

enum DealStage {
  PRE_LOI
  POST_LOI
  CLOSING
  CLOSED
  DEAD
}

model Engagement {
  id              String        @id @default(cuid())
  orgId           String
  org             ConsultantOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
  businessName    String
  // Target domain for Tier A automated checks (src/lib/audit/tierA.ts) — e.g. "example-restaurant.com".
  // Optional because an Engagement can be created before this is known; Tier A automation is simply
  // unavailable until it's set.
  primaryDomain   String?
  dealStage       DealStage     @default(PRE_LOI)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  // spec.md §8: document retention is tied to the Engagement lifecycle. Set when dealStage moves to
  // CLOSED or DEAD; a background job purges uploaded documents past this date. Null = not scheduled.
  documentPurgeAt DateTime?

  audits Audit[]
  vendorTermProfiles VendorTermProfile[]

  @@index([orgId])
  @@map("engagements")
}

// ---------------------------------------------------------------------------
// Template & checklist definition — spec.md §4-5
// ---------------------------------------------------------------------------

enum Tier {
  A
  B
  C
}

enum CheckMethod {
  AUTOMATED
  MANUAL
}

// Product-owned, shared content — NOT scoped to an org. Consultants select a Template; they never
// edit it in place. See docs/spec.md §5 and .claude/skills/audit-methodology/SKILL.md.
model Template {
  id          String   @id @default(cuid())
  slug        String // e.g. "restaurant-online-ordering" — stable across versions
  version     Int      @default(1)
  name        String
  description String?
  isActive    Boolean  @default(true) // new Audits pick the active version for a slug
  createdAt   DateTime @default(now())

  // What changed in this version relative to the previous one, in the consultant's language.
  // Templates are versioned (spec.md §5) specifically so a mid-engagement checklist change cannot
  // silently invalidate recorded findings — but a version number alone doesn't tell a consultant
  // comparing two reports what actually moved. Null on v1, which has no predecessor.
  changeNote  String?

  items  TemplateItem[]
  audits Audit[]

  @@unique([slug, version])
  @@map("templates")
}

// What a checklist item requires as evidence before a severity on it means anything.
// Not a hard gate — spec.md §4 leaves completion a consultant judgment call — but the product
// must be able to SAY that a Green with no document behind it is weaker than a Green with one.
enum EvidenceExpectation {
  NONE // a rating stands on the consultant's own observation (most Tier A manual items)
  DOCUMENT // Tier B: a seller/broker-provided document should back the finding
  ATTESTATION // Tier C: a named consultant attests they performed the check themselves
}

// spec.md §4: "Blocking dependency — whether the item requires deal-stage access the consultant
// may not have yet". Declared on the item so the product can tell a consultant, before they start,
// which items are simply not runnable at their current deal stage. This is the pre-LOI/post-LOI
// separation spec.md §2.3 calls load-bearing, made machine-readable.
enum BlockingDependency {
  NONE // runnable immediately, public information only
  SELLER_DOCUMENTS // needs the seller/broker to hand over documents (typically post-LOI)
  LIVE_ACCESS // needs live access to a seller-controlled system (typically very late pre-close)
}

model TemplateItem {
  id            String      @id @default(cuid())
  templateId    String
  template      Template    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tier          Tier
  method        CheckMethod
  title         String
  // CLIENT-FACING. This string is rendered verbatim into the whitelabeled PDF the consultant hands
  // to a buyer (src/lib/reports/renderHtml.ts). It must read as the consultant's own methodology —
  // no product cross-references, no "see spec.md §N", no CloseCheck implementation notes. Internal
  // commentary belongs in `guidance`/`severityGuidance` below, which never leave the app.
  description   String?
  // INTERNAL, consultant-facing only. How to actually perform this check: which registers to
  // search, which fields to read off a statement, what counts as done. Never rendered into a
  // client deliverable. This is the product's core IP (see .claude/skills/audit-methodology).
  guidance      String?
  // INTERNAL, consultant-facing only. When this item is Red vs Yellow vs Green, with the threshold
  // and its source where one exists. Severity has to be defensible to a buyer who pushes back, and
  // an unstated threshold makes one consultant's Yellow another's Red — which defeats the
  // repeatability that is the whole value proposition (spec.md §2.2).
  severityGuidance String?
  // Declares the structured fields this item captures, as {"fields":[...]} — see
  // src/lib/templates/fieldSchema.ts for the shape and the supported field kinds.
  //
  // This lives on TemplateItem, not in code, on purpose. spec.md §5 pins an in-progress Audit to
  // its Template version so checklist changes can't reinterpret recorded findings; a field set
  // defined in application code would sit outside that guarantee and silently change the meaning
  // of every historical Finding.structuredData when edited. Here it is versioned for free.
  fieldSchema   Json?
  evidenceExpectation EvidenceExpectation @default(NONE)
  blockingDependency  BlockingDependency  @default(NONE)
  // Stable key used by the Tier A automation runner (src/lib/audit/tierA) to know which checker to
  // invoke for AUTOMATED items — not meaningful for MANUAL items.
  automationKey String?
  sortOrder     Int         @default(0)

  findings Finding[]

  @@index([templateId])
  @@map("template_items")
}

// ---------------------------------------------------------------------------
// Audit & Finding — spec.md §3-4, §6 (severity roll-up)
// ---------------------------------------------------------------------------

enum AuditStatus {
  IN_PROGRESS
  COMPLETE
}

model Audit {
  id                        String        @id @default(cuid())
  orgId                     String
  org                       ConsultantOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
  engagementId              String
  engagement                Engagement    @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  templateId                String
  template                  Template      @relation(fields: [templateId], references: [id])
  status                    AuditStatus   @default(IN_PROGRESS)
  // spec.md §6: consultant override of the computed overall rating. The computed value is never
  // replaced by this — it is always recomputed and shown alongside the override, never persisted
  // as if it were the same field.
  overallRatingOverride     Severity?
  overallRatingOverrideNote String?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  findings Finding[]
  reports  Report[]

  @@index([orgId])
  @@index([engagementId])
  @@map("audits")
}

enum Severity {
  GREEN
  YELLOW
  RED
}

enum FindingStatus {
  NOT_STARTED
  IN_PROGRESS
  PASS
  FAIL
  NOT_APPLICABLE
  BLOCKED
}

model Finding {
  id             String        @id @default(cuid())
  orgId          String
  org            ConsultantOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
  auditId        String
  audit          Audit         @relation(fields: [auditId], references: [id], onDelete: Cascade)
  templateItemId String
  templateItem   TemplateItem  @relation(fields: [templateItemId], references: [id])
  status         FindingStatus @default(NOT_STARTED)
  severity       Severity?
  note           String?
  // Structured fields captured for Tier B document-derived findings (spec.md §4) — e.g.
  // { transferable: "unclear", penaltyAmount: "5000", penaltyBasis: "flat" }. Kept as JSON because
  // the structured fields differ per checklist item, not because the schema is unmodeled — see
  // spec.md §4's Tier B table for the fields each item actually needs.
  structuredData Json?
  updatedAt      DateTime      @updatedAt

  evidence Evidence[]

  @@unique([auditId, templateItemId])
  @@index([orgId])
  @@index([auditId])
  @@map("findings")
}

enum EvidenceKind {
  DOCUMENT // Tier B upload
  NOTE // free-text evidence, no file
  SCREENSHOT
}

model Evidence {
  id         String        @id @default(cuid())
  orgId      String
  org        ConsultantOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
  findingId  String
  finding    Finding       @relation(fields: [findingId], references: [id], onDelete: Cascade)
  kind       EvidenceKind
  // Object storage key/URL, not inline bytes — spec.md §8 (encrypted at rest, access-controlled per
  // Engagement). Null for NOTE-kind evidence.
  storageKey String?
  // The original filename, as uploaded. Doing double duty as the display label since the first
  // migration; `label` below is the consultant's own name for it where they give one.
  text       String?
  // Established at upload by src/lib/storage/uploadPolicy.ts, where both the declared type and the
  // file's own magic bytes have to agree. Recorded rather than discarded so the appendix can say
  // what a document actually is and how big it was — an appendix listing bare filenames is not
  // something a buyer's advisor can check anything against.
  mimeType   String?
  sizeBytes  Int?
  // Who attached it. spec.md §4's Tier C model rests on a NAMED professional attesting to what they
  // saw, and "the consultant" is not a name when a firm has several. Nullable because every row
  // written before this column existed has no answer, and inventing one would be worse.
  uploadedById String?
  uploadedBy   User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  // The consultant's own short name for this document, where the filename isn't one
  // ("Toast MSA, executed" beats "scan_0043.pdf").
  label      String?
  // Links this document to the specific structured claim it substantiates, as
  // { fieldKey, page?, excerpt? } — see src/lib/audit/sourceRef.ts.
  //
  // This is what separates a diligence work product from a checklist export. "Transferable: no" is
  // an assertion; "Transferable: no — §14.2, p.7 of toast-msa-2023.pdf: 'This Agreement may not be
  // assigned…'" is a finding a buyer's counsel can verify without asking anyone. spec.md §2.1 says
  // the report is the product, and this is the difference between the two.
  sourceRef  Json?
  createdAt  DateTime      @default(now())

  @@index([orgId])
  @@index([findingId])
  @@map("evidence")
}

// A record of what this firm found the last time it looked at a given vendor, on a given
// checklist item. spec.md §2.2: "the value proposition against ad hoc, no repeatable process is
// consistency across engagements."
//
// TENANT-OWNED, and the distinction matters more here than anywhere else in this schema. Template
// content is product-owned and shared between every consultant; this is derived from one firm's
// clients' executed contracts, and it is exactly the kind of data whose cross-tenant leak §8
// describes as catastrophic. orgId plus an RLS policy, like every other tenant table.
//
// Deliberately REFERENCE ONLY — nothing reads this to prefill a finding. See
// src/lib/audit/vendorMemory.ts for why: carrying one deal's recorded terms into another deal's
// report is a worse failure than retyping them.
model VendorTermProfile {
  id        String        @id @default(cuid())
  orgId     String
  org       ConsultantOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /**
   * The checklist item's title, as it stood on the template version the finding was rated against.
   * Titles are the only stable-ish identity a TemplateItem has across versions, and a retitled
   * item is arguably a different question — so fragmenting on a retitle is the honest behaviour,
   * not a bug to work around.
   */
  itemTitle String
  /** The vendor as the consultant typed it, normalised for matching (see vendorMemory.ts). */
  vendorKey String
  /** The vendor exactly as typed, for display — "Toast" and "toast pos" should not both show. */
  vendorLabel String
  /** The structured values recorded for that vendor on that item. */
  values    Json
  /**
   * The engagement this reading came from. One row per engagement rather than one per vendor,
   * deliberately: with a single row the deal currently being audited overwrites the very reading
   * it should be compared against, so the recall vanishes at the moment the consultant records
   * their own answer — which is exactly when the comparison becomes useful. Keeping a reading per
   * engagement means "what we found last time" always means a different deal.
   */
  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  /** Denormalised so the recall panel can name the deal without a join or a second lookup. */
  sourceBusinessName String
  recordedAt DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([orgId, itemTitle, vendorKey, engagementId])
  @@index([orgId])
  @@index([engagementId])
  @@map("vendor_term_profiles")
}

// ---------------------------------------------------------------------------
// Report — spec.md §6-7
// ---------------------------------------------------------------------------

model Report {
  id                      String        @id @default(cuid())
  orgId                   String
  org                     ConsultantOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
  auditId                 String
  audit                   Audit         @relation(fields: [auditId], references: [id], onDelete: Cascade)
  // Snapshot of computed severity roll-up at generation time, so a Report reflects "the state at the
  // stated date" (spec.md §6 disclaimer language) even if the Audit's findings change afterward.
  computedOverallSeverity Severity
  // Coverage snapshot alongside the severity above — src/lib/reports/rollup.ts's overallCoverage at
  // generation time. Required so any UI listing past Reports (not just the live audit page) can show
  // "GREEN (0/12 rated)" instead of a bare "GREEN" that reads as verified-safe (spec.md §6).
  overallCoveredCount     Int           @default(0)
  overallTotalCount       Int           @default(0)
  generatedAt             DateTime      @default(now())
  pdfStorageKey           String?

  // Whitelabel brand-kit snapshot, taken at generation time (spec.md §6: a Report is versioned and
  // exportable "at a point in time", and the PDF already embeds these values permanently). Without
  // it the Client Portal branded a months-old report with whatever the firm's branding happens to
  // be today — chrome that contradicts the document inside it — and had to read `consultant_orgs`
  // on every buyer view to do so. Nullable because Reports generated before this migration have no
  // snapshot; both readers fall back to the live org row for those (never the other way around).
  brandSnapshotFirmName   String?
  brandSnapshotColorHex   String?
  // A storage key holding a COPY of the logo bytes as they were at generation time, written under
  // this report's own key — NOT a pointer to `consultant_orgs.brandLogoUrl`.
  //
  // Pointing at the org's live key would snapshot nothing: `orgLogoKey` derives the key from the
  // uploaded filename, and uploadOrgLogo/removeOrgLogo (src/lib/actions/org.ts) delete the previous
  // object when a firm re-uploads — so the pointer would dangle at exactly the moment a rebrand
  // makes the snapshot matter. Bytes in the row itself were rejected instead: ConsultantOrg already
  // states the house rule ("Logo is a URL into object storage, not inline bytes"), and base64 of an
  // up-to-512KB logo would ride along on every portal view's SELECT of this table.
  brandSnapshotLogoKey    String?

  portalLinks ClientPortalLink[]

  @@index([orgId])
  @@index([auditId])
  @@map("reports")
}

// spec.md §7 — Phase 3, modeled now so the schema doesn't need a later migration for the shape
// decision (magic-link, no buyer account) that's already made. Not exposed by any route yet.
model ClientPortalLink {
  id        String        @id @default(cuid())
  orgId     String
  org       ConsultantOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
  reportId  String
  report    Report        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  token     String        @unique
  expiresAt DateTime
  revokedAt DateTime?
  /**
   * Which seat sent this report to the outside world.
   *
   * Creating a portal link is engagement-scoped work — any seat may do it, because delivering the
   * deliverable IS the job. But it is the one engagement-scoped action with outward blast radius,
   * and "any seat may do it" and "nobody can tell who did" must not both be true: without this the
   * firm could see that a report went to an outside party, and who viewed it, but not which of its
   * own people sent it. The §8 trail stopped at the firm boundary in the one place it mattered.
   *
   * SET NULL on user delete, like Evidence.uploadedById: the link must outlive the person, and a
   * cascade would erase the access history of a report that had already been shared.
   */
  createdById String?
  createdBy   User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())

  accessLog PortalAccessLogEntry[]

  @@index([orgId])
  @@map("client_portal_links")
}

// ---------------------------------------------------------------------------
// Programmatic access — spec.md §13 (Phase 4)
// ---------------------------------------------------------------------------

// spec.md §13.2: org-scoped, read-only API credentials. The plaintext token is shown exactly once at
// creation and never stored — tokenHash is sha256 of the full token (sha256, not bcrypt, because the
// token itself is a 32-byte random value with no dictionary to attack, and the hash doubles as the
// unique lookup column; a slow hash would add nothing but per-request latency). Cross-org lookup by
// hash happens via the dedicated `closecheck_api` role (src/lib/api/db.ts), mirroring how sign-in's
// email lookup works — never by widening closecheck_app's RLS.
model ApiKey {
  id          String        @id @default(cuid())
  orgId       String
  org         ConsultantOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  tokenHash   String        @unique
  // First characters of the token (e.g. "cc_live_a1b2c3") so keys stay identifiable in the settings
  // UI without retaining the secret.
  tokenPrefix String
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime      @default(now())

  @@index([orgId])
  @@map("api_keys")
}

// spec.md §13.3: signed-webhook endpoints. Unlike ApiKey.tokenHash, `secret` is stored as-is —
// dispatch must produce an HMAC with it on every delivery, so a one-way hash is impossible here.
// It is still org-scoped tenant data under RLS like everything else, and payloads it signs carry
// identifiers and status only, never findings/document content (spec.md §8).
model WebhookEndpoint {
  id                String        @id @default(cuid())
  orgId             String
  org               ConsultantOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
  url               String
  secret            String
  disabledAt        DateTime?
  // Best-effort delivery observability (spec.md §13.3 — limited retries, no guaranteed queue): the
  // last outcome per endpoint, not a per-delivery log table.
  lastSuccessAt     DateTime?
  lastFailureAt     DateTime?
  lastFailureReason String?
  createdAt         DateTime      @default(now())

  @@index([orgId])
  @@map("webhook_endpoints")
}

// ---------------------------------------------------------------------------
// Phase 2.5 — revenue readiness (docs/roadmap.md Phase 2.5, spec.md §9 revised 2026-09-21)
// ---------------------------------------------------------------------------

enum EmailStatus {
  SENT // accepted by the provider
  FAILED // provider rejected / errored
  LOGGED // no provider configured (dev / pre-Resend-key) — recorded here instead of delivered
}

// Transactional-email outbox/log (docs/roadmap.md Phase 2.5): every system email (team invite,
// portal link delivery, billing receipt) is recorded here regardless of whether a provider is
// configured — LOGGED rows double as the dev-mode "what would have been sent" view on /settings.
// Tenant data (recipient addresses belong to the org's people/deals): normal org RLS.
model EmailMessage {
  id         String        @id @default(cuid())
  orgId      String
  org        ConsultantOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
  to         String
  subject    String
  template   String // e.g. "team-invite", "portal-link", "receipt"
  status     EmailStatus
  providerId String? // Resend message id when SENT
  error      String?
  createdAt  DateTime      @default(now())

  @@index([orgId])
  @@map("email_messages")
}

enum BillingPlan {
  SOLO_MONTHLY
  SOLO_ANNUAL
  TEAM_MONTHLY
  TEAM_ANNUAL
}

enum BillingStatus {
  NONE // org exists, never checked out
  ACTIVE
  PAST_DUE
  CANCELED
}

// One row per org, created lazily at first checkout. The Stripe linkage: webhooks resolve the org
// from server-set metadata on the Stripe objects (signature-verified), then run through
// withOrgScope — no cross-org DB role needed for billing, unlike auth/api/portal lookups.
model BillingAccount {
  id                   String        @id @default(cuid())
  orgId                String        @unique
  org                  ConsultantOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
  stripeCustomerId     String        @unique
  stripeSubscriptionId String?
  plan                 BillingPlan?
  status               BillingStatus @default(NONE)
  currentPeriodEnd     DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@map("billing_accounts")
}

enum CreditReason {
  PLAN_GRANT // included audits granted on subscription create/renewal
  AUDIT_CONSUMED // one full (Tier B/C-bearing) Audit created — spec.md §9: Tier A alone is never metered
  OVERAGE // audit created with no credit balance — billed as a Stripe invoice item on the next
  // monthly rollup invoice (docs/roadmap.md Phase 2.5: batched, never charged per audit)
  ADJUSTMENT // manual founder correction
}

// Append-only credit ledger; balance = sum(delta). A ledger, not a counter column, so every grant
// and consumption stays auditable — the same "show your work" posture the Report's coverage
// snapshot takes (spec.md §6).
model AuditCreditEntry {
  id        String        @id @default(cuid())
  orgId     String
  org       ConsultantOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
  delta     Int
  reason    CreditReason
  auditId   String?
  note      String?
  createdAt DateTime      @default(now())

  @@index([orgId])
  @@map("audit_credit_ledger")
}

// Product telemetry (docs/roadmap.md Phase 2.5: spec.md §11's success metrics + error tracking),
// deliberately NOT tenant data and NOT org-readable: the app role gets INSERT-only on these two
// tables (see the migration), so no application code path — bug or not — can read another org's
// events back out. The founder reads them via scripts/metrics-report.ts (DIRECT role), the same
// trust boundary migrations and seeds already use. Rows carry ids and event names, never business
// content (no notes, no document data, no email bodies).
model MetricEvent {
  id        String   @id @default(cuid())
  orgId     String? // nullable: signup events fire before an org session exists
  type      String // e.g. "org.signed_up", "audit.created", "audit.completed", "report.generated", "portal.viewed"
  data      Json?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@map("metric_events")
}

model ErrorEvent {
  id        String   @id @default(cuid())
  orgId     String?
  source    String // e.g. "server-action", "api", "webhook-dispatch"
  message   String
  stack     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("error_events")
}

// spec.md §8 — audit logging of report access, needed once the portal ships.
enum PortalAccessKind {
  PAGE // the buyer opened the portal page
  DOCUMENT // the report bytes were fetched — the viewer embedded in the page, or a direct download
}

model PortalAccessLogEntry {
  id       String           @id @default(cuid())
  linkId   String
  link     ClientPortalLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  viewedAt DateTime         @default(now())
  /**
   * What was accessed. Recorded rather than used to decide whether to record at all.
   *
   * The PDF route previously skipped logging when `Sec-Fetch-Dest: iframe` was present, to avoid
   * double-counting the viewer's own fetch of the page it sits in. That header is forbidden to
   * browser scripts and entirely free for anything else, so sending it suppressed the row: ten
   * complete downloads left the consultant's access trail reading "never viewed". Nothing a client
   * controls may decide whether an access is recorded — the discriminator lives here instead, and
   * the summary collapses a page view and its own document fetch for display.
   */
  kind     PortalAccessKind @default(PAGE)
  ipHash   String?

  @@index([linkId])
  @@map("portal_access_log")
}
